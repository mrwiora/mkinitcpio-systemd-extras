#!/bin/bash

build() {
    # mkinitcpio does not source the helpers when the hook is run standalone
    declare -F tinyssh_add_server >/dev/null || . /usr/lib/initcpio/functions.d/systemd-extras

    tinyssh_add_base || return

    local keydir="${SD_TINYSSH_KEYDIR:-/etc/tinyssh/sshkeydir}"
    local public_key="$keydir/ed25519.pk"
    local secret_key="$keydir/.ed25519.sk"
    local tmpdir=

    if [[ -r "$public_key" && -r "$secret_key" ]]; then

        quiet "host key: '%s' and the secret key '%s'" "$public_key" "$secret_key"

    elif [[ -z "$SD_TINYSSH_KEYDIR" ]]; then

        tmpdir="$(mktemp -d)" || return 1
        if ! tinyssh_convert_openssh_key "$tmpdir/sshkeydir"; then
            rm -rf -- "$tmpdir"
            return 1
        fi
        public_key="$tmpdir/sshkeydir/ed25519.pk"
        secret_key="$tmpdir/sshkeydir/.ed25519.sk"

    else

        error "Missing SSH host key in '%s'" "$keydir"
        return 1

    fi

    # sealing on every build renews the policy whenever the measured state changed
    local pcrs=()
    [[ -n "$SD_TINYSSH_TPM2_PCRS" ]] && pcrs=( --tpm2-pcrs="$SD_TINYSSH_TPM2_PCRS" )

    add_dir /etc/tinyssh 700
    if systemd-creds encrypt --with-key=tpm2 "${pcrs[@]}" --name= \
            "$secret_key" "$BUILDROOT/etc/tinyssh/.ed25519.sk.enc"; then

        quiet "sealed the secret key to TPM2 PCRs %s" "${SD_TINYSSH_TPM2_PCRS:-7 (default)}"
        chmod 600 "$BUILDROOT/etc/tinyssh/.ed25519.sk.enc"
        add_file "$public_key" /etc/tinyssh/ed25519.pk

    else

        [[ -n "$tmpdir" ]] && rm -rf -- "$tmpdir"
        error "Sealing the secret key '%s' to the TPM failed" "$secret_key"
        return 1

    fi

    [[ -n "$tmpdir" ]] && rm -rf -- "$tmpdir"

    tinyssh_add_start_script

    tinyssh_add_server \
        "ExecStart=" \
        "ExecStart=-/usr/bin/tinyssh-start $(tinyssh_command_option)"
}

help() {
    cat <<__EOF_HELP__
This hook enables tinyssh during the initramfs phase. It is only applicable for
a systemd based intramfs phase, i.e. hook 'systemd' must be given in the HOOKS
array in mkinitcpio.conf.

See https://github.com/wolegis/mkinitcpio-systemd-extras/wiki/TinySSH-server
for details.

The hook copies all files and binaries required by tinyssh to the initramfs
image and enables listening TCP port 22 (or some other).

This variant seals the secret host key to the TPM while the image is built, so
nothing has to be prepared by hand and the key is resealed against the current
PCR values on every rebuild. That repairs the host key after a firmware update:
boot once, unlock at the console or with the throwaway key described below, and
the next 'mkinitcpio' run makes the image work again.

Set SD_TINYSSH_TPM2_PCRS to the PCRs to seal against, e.g. "0+7". If it is
unset, the default of systemd-creds is used, which is PCR 7 alone.

The key pair to seal is taken from \$SD_TINYSSH_KEYDIR (default
/etc/tinyssh/sshkeydir), create it with:

  tinysshd-makekey /etc/tinyssh/sshkeydir

If \$SD_TINYSSH_KEYDIR is left unset and no key pair exists there, the OpenSSH
host key /etc/ssh/ssh_host_ed25519_key of the running system is converted on
the fly instead. That conversion requires python to be installed.

At boot /usr/bin/tinyssh-start decrypts the key itself instead of leaving that
to systemd, because a credential that cannot be decrypted fails its unit before
the server is even started. Should the decryption fail, the script generates a
throwaway host key, so that a volume can still be unlocked from remote. The ssh
client reports a changed host key then and refuses to connect until the old key
is removed from its known_hosts file, e.g. with 'ssh-keygen -R <host>'.

By default tinyssh presents the busybox shell after successful login. Two
variables can be used to alter this behavior:

SD_TINYSSH_COMMAND defines a shell command. The string is appended to 'sh -c',
i.e. it may contain blanks, quotes and all kinds of special characters that are
interpreted by the shell.  Example: To allow to unlock LUKS encrypted volumes
from remote (but nothing else, especially no shell access) set:
SD_TINYSSH_COMMAND="systemd-tty-ask-password-agent --query --watch"

SD_TINYSSH_SCRIPT defines a file with shell commands that are executed before
the interactive shell is presented. Example: To allow to unlock LUKS encrypted
volumes from remote but also escape to an interactive shell with CTRL-C specify
a file that contains:
systemd-tty-ask-password-agent --query --watch

SD_TINYSSH_COMMAND takes precedence.

Set SD_TINYSSH_PORT to specify a port other than 22.

Set SD_TINYSSH_AUTHORIZED_KEYS to specify a keys file other than
/root/.ssh/authorized_keys.

If required the above mentioned variables must be set in /etc/mkinitcpio.conf.
__EOF_HELP__
}
