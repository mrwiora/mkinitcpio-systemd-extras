#!/bin/bash

build() {
    # Host key sources, in order of preference:
    #   1. public key + secret key encrypted with systemd-creds
    #   2. public key + secret key in cleartext
    #   3. OpenSSH host key of the running system, converted on the fly

    # tinysshd and tinyssh-convert are taken from the host installation, so the package must be installed
    if ! pacman -Qi tinyssh >/dev/null 2>&1; then
        error "Package tinyssh not installed"
        return 1
    fi

    # mkinitcpio does not source the helpers when the hook is run standalone
    declare -F add_busybox >/dev/null || . /usr/lib/initcpio/functions.d/systemd-extras

    add_busybox || return

    add_binary tinysshd-makekey

    # holds the assembled key directory, unlike /run it is not carried over into the booted system
    add_dir /tmp 1777

    # variable and defaults definition
    local keydir="${SD_TINYSSH_KEYDIR:-/etc/tinyssh/sshkeydir}"
    local public_key="$keydir/ed25519.pk"
    local secret_key="$keydir/.ed25519.sk"
    local secret_key_encrypted="$keydir/.ed25519.sk.enc"
    local openssh_host_key=/etc/ssh/ssh_host_ed25519_key

    # the key material is placed here, the start script below turns it into a key directory at boot
    local srcdir=/etc/tinyssh

    # Option A. check if the public key and the encrypted secret key are readable
    if [[ -r "$public_key" && -r "$secret_key_encrypted" ]]; then

        quiet "host key: '%s' and the secret key '%s' encrypted with systemd-creds" "$public_key" "$secret_key_encrypted"
        add_file "$public_key" "$srcdir/ed25519.pk"
        add_file "$secret_key_encrypted" "$srcdir/.ed25519.sk.enc"
        add_binary systemd-creds

    # Option B. check if the public key and the cleartext secret key are readable
    elif [[ -r "$public_key" && -r "$secret_key" ]]; then

        quiet "host key: '%s' and the secret key '%s' in cleartext" "$public_key" "$secret_key"
        add_file "$public_key" "$srcdir/ed25519.pk"
        add_file "$secret_key" "$srcdir/.ed25519.sk"

    # Option C. fall back to the OpenSSH host key if no key directory is specified and the key is readable
    elif [[ -z "$SD_TINYSSH_KEYDIR" && -r "$openssh_host_key" ]]; then

        quiet "host key: OpenSSH host key '%s', converted in cleartext" "$openssh_host_key"
        tinyssh-convert "$BUILDROOT$srcdir" <"$openssh_host_key"
        warning "Reusing the SSH host keys from the regular operating environment poses a security risk."
        warning "Initramfs is unencrypted and the SSH host key is exposed, so impersonation is easily possible."

    # Option D. no valid key found
    else

        error "Missing SSH host key, checked '%s', '%s' and '%s'" "$secret_key_encrypted" "$secret_key" "$openssh_host_key"
        return 1

    fi

    # tinysshd is started through a script because the host key must be resolved without systemd:
    # a credential that fails to decrypt fails its unit before any ExecStart= of that unit runs
    local start_script=(
        '#!/usr/bin/sh'
        ''
        'srcdir=/etc/tinyssh'
        'keydir=/tmp/tinysshd'
        ''
        '# mkdir doubles as the lock, only the first connection assembles the key directory'
        'if [ ! -s "$keydir/.ed25519.sk" ] && mkdir "$keydir" 2>/dev/null; then'
        ''
        '    chmod 700 "$keydir"'
        ''
        '    if [ -r "$srcdir/.ed25519.sk.enc" ] &&'
        '       /usr/bin/systemd-creds decrypt --name= "$srcdir/.ed25519.sk.enc" "$keydir/.ed25519.sk"; then'
        '        cp "$srcdir/ed25519.pk" "$keydir/ed25519.pk"'
        '    elif [ -r "$srcdir/.ed25519.sk" ]; then'
        '        cp "$srcdir/ed25519.pk" "$srcdir/.ed25519.sk" "$keydir/"'
        '    else'
        '        # a key sealed to the TPM is lost when the platform state changes, e.g. on a firmware update'
        '        echo "tinyssh-start: no usable host key, generating a throwaway key" >&2'
        '        rm -rf "$keydir" && /usr/bin/tinysshd-makekey -q "$keydir"'
        '    fi'
        ''
        'fi'
        ''
        'exec /usr/bin/tinysshd "$@" "$keydir"'
    )
    printf "%s\n" "${start_script[@]}" > "$BUILDROOT/usr/bin/tinyssh-start"
    chmod 755 "$BUILDROOT/usr/bin/tinyssh-start"

    # add the systemd units for tinyssh
    add_systemd_unit tinyssh@.socket
    add_systemd_unit tinyssh@.service

    # enable tinysshd listening on TCP port $SD_TINYSSH_PORT (if set to legal port number)
    SD_TINYSSH_PORT="${SD_TINYSSH_PORT:-22}"
    if (( SD_TINYSSH_PORT < 1 || SD_TINYSSH_PORT > 65535 )); then
        error "Illegal value SD_TINYSSH_PORT=$SD_TINYSSH_PORT"
        return 1
    fi
    # create the symlink for the tinyssh socket in the systemd wants directory
    add_symlink "/etc/systemd/system/sysinit.target.wants/tinyssh@$SD_TINYSSH_PORT.socket" /usr/lib/systemd/system/tinyssh@.socket

    # create the systemd drop-in for the tinyssh socket
    local drop_in=(
        '[Unit]'
        'Requires=systemd-networkd.service'
        'After=systemd-networkd.service'
        'DefaultDependencies=no'
    )
    printf "%s\n" "${drop_in[@]}" | add_systemd_drop_in "tinyssh@$SD_TINYSSH_PORT.socket" override

    # create the systemd drop-in for the tinyssh service
    drop_in=(
        "[Unit]"
        "DefaultDependencies=no"
        "CollectMode=inactive-or-failed"
        ""
        "[Service]"
        "ExecStart="
        "ExecStart=-/usr/bin/tinyssh-start ${SD_TINYSSH_COMMAND:+-e '${SD_TINYSSH_COMMAND}'}"
    )
    printf "%s\n" "${drop_in[@]}" | add_systemd_drop_in tinyssh@.service override

    # check for the presence of the authorized keys file for root
    SD_TINYSSH_AUTHORIZED_KEYS=${SD_TINYSSH_AUTHORIZED_KEYS:-/root/.ssh/authorized_keys}

    # ensure the authorized keys file is readable
    if [[ ! -r "$SD_TINYSSH_AUTHORIZED_KEYS" ]]; then
        error "Keys file '$SD_TINYSSH_AUTHORIZED_KEYS' does not exist (or not readable)"
        return 1
    fi

    # create the .ssh directory for root in the initramfs
    add_dir /root/.ssh

    # tinyssh speaks ED25519 only, so every other key type is dropped here
    quiet "authorized keys for root: '%s'" "$SD_TINYSSH_AUTHORIZED_KEYS"
    grep '^ssh-ed25519 ' "$SD_TINYSSH_AUTHORIZED_KEYS" >"$BUILDROOT/root/.ssh/authorized_keys"
    if [[ -s "$BUILDROOT/root/.ssh/authorized_keys" ]]; then
        quiet "added %s of %s key(s), only ED25519 keys are accepted by tinyssh" \
            "$(grep -c '' "$BUILDROOT/root/.ssh/authorized_keys")" \
            "$(grep -c '^[^#[:space:]]' "$SD_TINYSSH_AUTHORIZED_KEYS")"
        chmod 600 "$BUILDROOT/root/.ssh/authorized_keys"
        chmod 700 "$BUILDROOT/root/.ssh"
    else
        error "No ED25519 key found for root in '%s'" "$SD_TINYSSH_AUTHORIZED_KEYS"
        return 1
    fi

    # the login script is pointless when a fixed command replaces the shell
    if [[ -z "$SD_TINYSSH_COMMAND" && -r "$SD_TINYSSH_SCRIPT" ]]; then
        add_file "$SD_TINYSSH_SCRIPT" /root/.profile 600
    fi
}

help() {
    cat <<__EOF_HELP__
This hook enables tinyssh during the initramfs phase. It is only applicable for
a systemd based intramfs phase, i.e. hook 'systemd' must be given in the HOOKS
array in mkinitcpio.conf.

See https://github.com/wolegis/mkinitcpio-systemd-extras/wiki/TinySSH-server
for details.

The hook copies all files and binaries required by tinyssh to the initramfs
image and enables listening TCP port 22 (or some other).

Host keys are copied from \$SD_TINYSSH_KEYDIR (default /etc/tinyssh/sshkeydir).
A secret host key '.ed25519.sk.enc' encrypted with systemd-creds is preferred.
As a last resort the OpenSSH host key /etc/ssh/ssh_host_ed25519_key is
converted on the fly.  This last option requires python to be installed.

The key material is unpacked at boot by /usr/bin/tinyssh-start, which decrypts
an encrypted secret key itself instead of leaving it to systemd. An encrypted
host key cannot be decrypted any more once the state it is sealed to changes,
e.g. after a firmware update, and a failing credential would take the whole ssh
server down with it. In that case the script generates a throwaway host key, so
that a volume can still be unlocked from remote. The ssh client reports a
changed host key then and refuses to connect until the old key is removed from
its known_hosts file.

By default tinyssh presents the busybox shell after successful login. Two
variables can be used to alter this behavior:

SD_TINYSSH_COMMAND defines a shell command. The string is appended to 'sh -c',
i.e. it may contain blanks, quotes and all kinds of special characters that are
interpreted by the shell.  Example: To allow to unlock LUKS encrypted volumes
from remote (but nothing else, especially no shell access) set:
SD_TINYSSH_COMMAND="systemd-tty-ask-password-agent --query --watch"

SD_TINYSSH_SCRIPT defines a file with shell commands that are executed before
the interactive shell is presented. Example: To allow to unlock LUKS encrypted
volumes from remote but also escape to an interactive shell with CTRL-C specify
a file that contains:
systemd-tty-ask-password-agent --query --watch

SD_TINYSSH_COMMAND takes precedence.

Set SD_TINYSSH_PORT to specify a port other than 22.

Set SD_TINYSSH_AUTHORIZED_KEYS to specify a keys file other than
/root/.ssh/authorized_keys.

If required the above mentioned variables must be set in /etc/mkinitcpio.conf.
__EOF_HELP__
}